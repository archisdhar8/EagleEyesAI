# Required when migrating private application data from local SQLite to Supabase.
# Keep either the server-side secret key or Postgres connection string out of Git.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=
SUPABASE_PUBLISHABLE_KEY=
DATABASE_URL=
# Exact comma-separated browser origins allowed to call the API in production.
# Localhost development origins remain allowed automatically.
CORS_ALLOWED_ORIGINS=https://your-project.vercel.app
POLYGON_API_KEY=
MARKET_SNAPSHOT_MODE=
POLYGON_REALTIME_ENTITLED=false
TIINGO_API_KEY=
FRED_API_KEY=
SEC_USER_AGENT=EagleEyesAI your-email@example.com

# Optional. Only required for an OpenAI-compatible explanation provider.
DASHBOARD_LLM_API_KEY=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash
GEMINI_MAX_RETRIES=1
GEMINI_MAX_CONTINUATIONS=1
GEMINI_CHAT_TIMEOUT_SECONDS=7
GEMINI_CHAT_MAX_OUTPUT_TOKENS=3200
ASK_TOOL_BUDGET_SECONDS=10
ASK_ROUTER_V2=1
# Keep memory-heavy pandas/numpy chat analysis bounded on small instances.
CHAT_ANALYSIS_CONCURRENCY=1
OPENBLAS_NUM_THREADS=1
OMP_NUM_THREADS=1
MKL_NUM_THREADS=1
DASHBOARD_PLANNER_MAX_ATTEMPTS=2
DASHBOARD_TASK_MAX_ATTEMPTS=2
DASHBOARD_TASK_TIMEOUT_SECONDS=45
DASHBOARD_NARRATIVE_TIMEOUT_SECONDS=30
DB_CONNECT_TIMEOUT_SECONDS=5
DB_STATEMENT_TIMEOUT_MS=15000
