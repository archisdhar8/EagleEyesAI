        "id": "why-invest-v1",
        "version": "1",
        "questions": [
          {"question": "Which money is normally best kept out of volatile investments?", "options": ["Money needed for an emergency next month", "Money intended for retirement in 30 years", "Money with no planned use", "A long-term contribution"], "correct": 0, "explanation": "Near-term and emergency money needs stability and access; market investments can fall when the money is needed."},
          {"question": "What does compounding mean?", "options": ["Returns are guaranteed", "Earlier growth can itself earn later growth", "Inflation stops affecting money", "Risk disappears with time"], "correct": 1, "explanation": "Compounding is growth on both the original amount and earlier gains. It does not guarantee a positive outcome."}
        ]
      },
